__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
# NOTHING UNDER data/ IS EVER COMMITTED. Listed wholesale rather than
# path by path after a real incident, 2026-09-25: REQ-PIPE-068 created
# data/supply.duckdb and data/dbt_scratch/, a `git add -A` staged them
# in the window BEFORE their ignore lines existed, and a gitignore
# never applies to an already-tracked file - so 404MB of scratch
# databases went into a public repo and the later ignore lines did
# nothing. A catch-all closes the window for the next artefact too.
data/
# The specific paths below are kept for readability - they say what is
# actually in there - and are redundant under the line above.
data/raw/
data/cp_raw/
# REQ-GEN-043's delivery format. In a real deployment these hold real
# Birth Registrations and Child Protection extracts, so no part of the
# format may require committing a delivery's contents - see
# docs/delivery-format.md. data/receipts/ is OURS rather than a
# supplier's, and is gitignored for the same reason: it is generated.
data/deliveries/
data/receipts/
data/generator_bookkeeping.json
data/warehouse.duckdb
data/warehouse.db
data/duckdb_runs/
data/cp_duckdb_runs/
# REQ-PIPE-068 replaced the two directories above with one supply
# database plus dbt's own per-run scratch. They are left listed so a
# checkout that still has them stays clean.
data/supply.duckdb
data/dbt_scratch/
reports/results_bdm.json
reports/results_cp.json
reports/birth_registrations_dashboard.json
reports/child_protection_dashboard.json
dbt_project/target/
dbt_project/logs/
dbt_project/dbt_packages/
.dbt/
qa_tools/dbt_profiles/.user.yml
dashboard/snapshots/*.html
dashboard/qa-reporting-dashboard.html
.coverage
node_modules/

# Playwright MCP server scratch output - @playwright/mcp writes page snapshots
# and console logs into the workspace root (see .mcp.json)
.playwright-mcp/

# REQ-PIPE-062's filings are NOT recorded yet (Keith, 2026-09-25). The
# assignment rule is built and tested; recording is off until promotion
# exists to fill a slot, because a filing is write-once and today every
# late supply files against the oldest slot in the calendar - 102 of 108
# on a real run. Ignored so a local experiment cannot stage that state
# into permanent history. Remove this when the promotion sprint turns
# recording on: filings/ is committed history from that point.
filings/
