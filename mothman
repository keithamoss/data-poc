#!/usr/bin/env bash
# The mothman CLI/TUI entry point (plans/tooling.md #1). `uv run mothman
# ...` (the real `[project.scripts]` console-script entry, pyproject.toml
# - only actually installed once `tool.uv.package`/`[build-system]` were
# added, Phase 4, 2026-09-19: `uv sync` was silently skipping entry-point
# installation before that) already works from anywhere `uv run` does -
# this wrapper is just a shorter `./mothman` for repo-root use, delegating
# to the exact same entry point rather than a separate `python3 -m`
# fallback, so the two invocation styles can't drift.
#
# Run from the repo root: ./mothman [command] [options]
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
exec uv run mothman "$@"
