{
  "name": "data-poc",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/data-poc",

  // PINNED, AND PINNED TO MATCH CI. The PostgreSQL major here is the
  // same one .github/workflows/test.yml's service container uses, so a
  // green suite in here means the same thing as a green suite there.
  // REQ-PIPE-093 will make that version a declared value both can read
  // rather than two places agreeing by hand - until then, changing one
  // means changing the other.
  "remoteEnv": {
    "MOTHMAN_TEST_DSN": "postgresql://user:password@db:5432/postgres",
    "MOTHMAN_ENVIRONMENT": "local",
    // NO MOTHMAN_ASSET: which data asset a command acts for is chosen each
    // time, with no default (REQ-PIPE-363 criterion 1). It said
    // data-asset-1 until 2026-11-15, which names no asset folder since the
    // split, so every command refused. post-create.sh marks each asset's
    // own database, supply_<asset>, on this server (REQ-PIPE-343).
    // NO MOTHMAN_SUPPLY_DSN either (Keith, 2026-11-15): each command opens
    // its asset's own supply_<asset>, found from MOTHMAN_ASSET, on the
    // server MOTHMAN_PG names - a URL naming no database, CI's name for the
    // same. docker-compose.yml's init script creates each one.
    "MOTHMAN_PG": "postgresql://user:password@db:5432",
    // The pre-installed Chromium, same as this project's cloud sessions
    // use - the pinned playwright package expects a newer build than
    // the image ships, so it is pointed at the one that is there.
    "PLAYWRIGHT_BROWSERS_PATH": "/opt/pw-browsers",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
  },

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
