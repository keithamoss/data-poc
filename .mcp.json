{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82",
        "--headless",
        "--executable-path",
        "/opt/pw-browsers/chromium",
        "--no-sandbox",
        "--isolated",
        "--ignore-https-errors"
      ]
    }
  }
}
